{
  "name": "byot-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:page": "npm run build && node build-page.js",
    "typecheck": "tsc --noEmit --strict --target ES2020 --module ESNext --moduleResolution Bundler --jsx react-jsx --esModuleInterop --skipLibCheck src/index.tsx",
    "test": "npm run test:ui && npm run test:byot --",
    "test:ui": "node tools/byot-ui-test.mjs",
    "test:byot": "node tools/byot-test.mjs"
  },
  "dependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.2.2",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tailwindcss": "^3.3.3",
    "postcss": "^8.4.27",
    "autoprefixer": "^10.4.19"
  }
}
